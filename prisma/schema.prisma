// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ===================================
// ENUMS
// ===================================

enum Role {
  ADMIN
  PRIEST
  VISITATION_SERVANT
  SUNDAY_SCHOOL_SERVANT
  PARENT
  CHILD
  REGULAR_MAKHDOUM
}

enum PriestStatus {
  ACTIVE
  STRESSED
  SANCTIONED
}

enum FamilyStatus {
  NORMAL
  WIDOWED
  POOR
  DIVORCED
  OTHER
}

enum Gender {
  MALE
  FEMALE
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum LinkStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum BookingStatus {
  BOOKED
  PAID
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  EXCUSED
}

enum ServingDay {
  THURSDAY
  FRIDAY
}

enum ContentType {
  VERSE
  QUESTION
}

enum TaskStatus {
  PENDING
  COMPLETED
}

// ===================================
// MODELS
// ===================================

model User {
  id        String  @id @default(cuid())
  email     String  @unique
  password  String // Hashed password
  name      String
  role      Role
  avatarUrl String?

  // Profile links (One-to-One)
  priestProfile   PriestProfile?
  servantProfile  ServantProfile?
  childProfile    ChildProfile?

  // Relationships as a requester/participant
  confessionAppointments Appointment[]     @relation("ConfessorAppointments")
  tripBookings           TripBooking[]
  sentParentLinks        ParentChildLink[] @relation("ParentLinks")
  receivedParentLinks    ParentChildLink[] @relation("ChildLinks")
  makhdoumTasks          MakhdoumTask[]    @relation("AssignedTasks")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

// --- Role-Specific Profiles ---

model PriestProfile {
  id      String   @id @default(cuid())
  user    User     @relation(fields: [userId], references: [id])
  userId  String   @unique
  status  PriestStatus @default(ACTIVE)
  bio     String?

  // Relationships as a manager/assigner
  assignedFamilies          Family[]
  confessionAppointments    Appointment[]     @relation("PriestAppointments")
  createdTrips              Trip[]
  assignedMakhdoumTasks     MakhdoumTask[]    @relation("AssignedByPriest")
  assignedVisitationTasks   VisitationTask[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("priest_profiles")
}

model ServantProfile {
  id           String @id @default(cuid())
  user         User   @relation(fields: [userId], references: [id])
  userId       String @unique
  servantType  String // "VISITATION" or "SUNDAY_SCHOOL"
  points       Int    @default(0)

  // Sunday School Servant Specific
  servingDays       ServingDay[]
  attendanceRecords ServantAttendance[]
  createdContent    WeeklyContent[]

  // Visitation Servant Specific
  visitationTasks   VisitationTask[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("servant_profiles")
}

model ChildProfile {
  id         String @id @default(cuid())
  user       User   @relation(fields: [userId], references: [id])
  userId     String @unique
  qrCode     String @unique
  points     Int    @default(0)
  bloodType  String?

  // Relationships
  familyMember          FamilyMember?
  attendanceRecords     ChildAttendance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("child_profiles")
}

model ParentProfile {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id])
  userId String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("parent_profiles")
}


// --- Core App Models ---

model Family {
  id          String      @id @default(cuid())
  fatherName  String
  motherName  String
  phoneNumber String
  address     String
  region      String
  status      FamilyStatus
  notes       String?
  lastVisited DateTime?

  priest        PriestProfile @relation(fields: [priestId], references: [id])
  priestId      String

  members         FamilyMember[]
  visitationTasks VisitationTask[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([priestId])
  @@map("families")
}

model FamilyMember {
  id        String  @id @default(cuid())
  name      String
  age       Int
  gender    Gender
  notes     String?

  family      Family        @relation(fields: [familyId], references: [id])
  familyId    String
  childProfile ChildProfile?  @relation(fields: [childProfileId], references: [id])
  childProfileId String?     @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([familyId])
  @@map("family_members")
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  content   String
  authorId  String
  createdAt DateTime @default(now())

  @@map("announcements")
}

model ChurchInformation {
  id            String  @id @default(cuid())
  name          String
  address       String
  contactNumber String
  latitude      Float?
  longitude     Float?

  @@map("church_information")
}

model Appointment {
  id          String   @id @default(cuid())
  datetime    DateTime
  duration    Int      @default(30) // in minutes
  status      AppointmentStatus @default(PENDING)
  notes       String?
  bookedBySystem Boolean @default(false)
  
  confessor   User     @relation("ConfessorAppointments", fields: [confessorId], references: [id])
  confessorId String

  priest      PriestProfile @relation("PriestAppointments", fields: [priestId], references: [id])
  priestId    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([confessorId])
  @@index([priestId])
  @@map("appointments")
}

model ParentChildLink {
  id        String   @id @default(cuid())
  status    LinkStatus @default(PENDING)
  
  parent    User     @relation("ParentLinks", fields: [parentId], references: [id])
  parentId  String

  child     User     @relation("ChildLinks", fields: [childId], references: [id])
  childId   String

  requestedAt DateTime @default(now())
  respondedAt DateTime?

  @@unique([parentId, childId])
  @@index([parentId])
  @@index([childId])
  @@map("parent_child_links")
}


// --- Trips ---

model Trip {
  id          String   @id @default(cuid())
  title       String
  destination String
  startDate   DateTime
  endDate     DateTime
  price       Float
  capacity    Int
  overview    String
  itinerary   String
  included    String
  excluded    String
  
  creator     PriestProfile @relation(fields: [creatorId], references: [id])
  creatorId   String

  bookings    TripBooking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([creatorId])
  @@map("trips")
}

model TripBooking {
  id          String    @id @default(cuid())
  bookingCode String    @unique
  status      BookingStatus @default(BOOKED)

  trip        Trip      @relation(fields: [tripId], references: [id])
  tripId      String

  user        User      @relation(fields: [userId], references: [id])
  userId      String
  
  bookedAt    DateTime  @default(now())
  paidAt      DateTime?

  @@index([tripId])
  @@index([userId])
  @@map("trip_bookings")
}

// --- Sunday School ---

model ServantAttendance {
  id              String      @id @default(cuid())
  date            DateTime
  serviceDay      ServingDay
  status          AttendanceStatus
  notes           String?
  recordedBy      String // "priest" or "servant"
  isGeoVerified   Boolean?  @default(false)
  
  servant         ServantProfile @relation(fields: [servantId], references: [id])
  servantId       String

  @@index([servantId])
  @@map("servant_attendance")
}

model ChildAttendance {
  id              String      @id @default(cuid())
  date            DateTime
  serviceDay      ServingDay
  pointsAwarded   Int

  child           ChildProfile @relation(fields: [childId], references: [id])
  childId         String

  recordedByServant   ServantProfile? @relation(fields: [recordedByServantId], references: [id])
  recordedByServantId String?

  recordedByPriest    Boolean         @default(false)

  @@index([childId])
  @@index([recordedByServantId])
  @@map("child_attendance")
}

model WeeklyContent {
  id            String      @id @default(cuid())
  type          ContentType
  title         String
  content       String
  options       String[]
  correctAnswer String?
  points        Int
  isActive      Boolean     @default(true)

  creator       ServantProfile @relation(fields: [creatorId], references: [id])
  creatorId     String

  createdAt     DateTime    @default(now())

  @@index([creatorId])
  @@map("weekly_content")
}

// --- Visitation & Makhdoum Tasks ---

model VisitationTask {
  id           String      @id @default(cuid())
  status       TaskStatus  @default(PENDING)
  priestNotes  String?
  servantNotes String?
  assignedAt   DateTime    @default(now())
  completedAt  DateTime?

  family       Family        @relation(fields: [familyId], references: [id])
  familyId     String

  servant      ServantProfile @relation(fields: [servantId], references: [id])
  servantId    String

  assignedBy   PriestProfile @relation(fields: [assignedById], references: [id])
  assignedById String
  
  @@index([familyId])
  @@index([servantId])
  @@index([assignedById])
  @@map("visitation_tasks")
}

model MakhdoumTask {
  id           String      @id @default(cuid())
  title        String
  description  String?
  status       TaskStatus  @default(PENDING)
  assignedAt   DateTime    @default(now())
  completedAt  DateTime?

  assignee     User          @relation("AssignedTasks", fields: [assigneeId], references: [id])
  assigneeId   String

  assigner     PriestProfile @relation("AssignedByPriest", fields: [assignerId], references: [id])
  assignerId   String

  @@index([assigneeId])
  @@index([assignerId])
  @@map("makhdoum_tasks")
}
